# Valores públicos de ejemplo
# Inyectar desde Apache, Docker o systemd.

CMM_STATE_DIR=/var/lib/cmm/state
CMM_POSTER_ROOT=/var/lib/cmm/posters
CMM_LIBRARY_URL=http://127.0.0.1/centro-multimedia/api/biblioteca.php
CMM_WRITER_SOCKET=/run/cmm/cmm-action-writer.sock
CMM_AUTHORIZER_SOCKET=/run/cmm/cmm-delete-authorizer.sock
CMM_PROPOSAL_CREATE_ENABLED=false
CMM_PROTECTED_PREFIXES=/etc/,/home/,/root/,/run/,/var/lib/,/srv/private/
